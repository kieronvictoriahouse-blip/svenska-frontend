{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/a-propos", "destination": "/page" },
    { "source": "/media/:path*", "destination": "https://joznctfeujgnfydbpsbm.supabase.co/storage/v1/object/public/svenska-media/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
