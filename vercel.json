{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/a-propos", "destination": "/page" },
    { "source": "/media-w/:w/:path*", "destination": "https://fdagtzhodyxulhqbkkoz.supabase.co/storage/v1/render/image/public/svenska-media/:path*?width=:w&resize=contain&quality=75" },
    { "source": "/media/:path*", "destination": "https://fdagtzhodyxulhqbkkoz.supabase.co/storage/v1/object/public/svenska-media/:path*" },
    { "source": "/produit/:slug", "destination": "/produit" },
    { "source": "/compte/:path*", "destination": "/compte" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media-w/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vary", "value": "Accept" }
      ]
    }
  ]
}
